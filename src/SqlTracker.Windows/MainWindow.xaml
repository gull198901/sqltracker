<Window x:Class="SqlTracker.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SqlTracker.Windows.ViewModels"
        Title="SqlTracker Next" Height="760" Width="1180"
        MinHeight="560" MinWidth="920">
  <Window.DataContext>
    <vm:MainViewModel />
  </Window.DataContext>

  <Grid Background="#F5F6F8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D8DDE6" BorderThickness="0,0,0,1">
      <DockPanel Margin="10,8">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,6,0" Padding="10,5" />
          <Button Content="Start" Command="{Binding StartCommand}" Margin="0,0,6,0" Padding="10,5" />
          <Button Content="Pause" Command="{Binding PauseCommand}" Margin="0,0,6,0" Padding="10,5" />
          <Button Content="Stop" Command="{Binding StopCommand}" Margin="0,0,6,0" Padding="10,5" />
          <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,6,0" Padding="10,5" />
          <Button Content="Save" Command="{Binding SaveCommand}" Margin="0,0,6,0" Padding="10,5" />
          <Button Content="Help" Command="{Binding HelpCommand}" Margin="0,0,6,0" Padding="10,5" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
          <TextBlock Text="costs &gt;= " VerticalAlignment="Center" Margin="18,0,4,0" />
          <TextBox Text="{Binding MinElapsedText, UpdateSourceTrigger=PropertyChanged}" Width="72" VerticalContentAlignment="Center" />
          <TextBlock Text=" ms" VerticalAlignment="Center" Margin="4,0,12,0" />
          <TextBlock Text="SQL keyword" VerticalAlignment="Center" Margin="0,0,4,0" />
          <TextBox Text="{Binding SqlKeyword, UpdateSourceTrigger=PropertyChanged}" Width="220" VerticalContentAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="390" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D8DDE6" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Target Processes" FontWeight="SemiBold" Margin="10,8" />
          <ListBox Grid.Row="1"
                   ItemsSource="{Binding Processes}"
                   SelectedItem="{Binding SelectedProcess}"
                   BorderThickness="0"
                   Margin="1,0,1,1"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4,4,4,5">
                  <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ProgramPath}"
                             Foreground="#4B5563"
                             FontSize="11"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D8DDE6" BorderThickness="1">
        <RichTextBox x:Name="TraceOutput"
                     FontFamily="Consolas"
                     FontSize="13"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0" />
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D8DDE6" BorderThickness="0,1,0,0">
      <DockPanel Margin="10,6">
        <TextBlock Text="vibe coding  gll1989 V1.0"
                   DockPanel.Dock="Right"
                   Foreground="#4B5563"
                   FontWeight="SemiBold"
                   Margin="18,0,0,0" />
        <TextBlock Text="{Binding StatusText}" Foreground="#4B5563" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
