<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(SqlTrackerCoreTargetFramework)</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlTracker.Core\SqlTracker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SqlTracker.Windows\Services\AgentPathResolver.cs" Link="Services\AgentPathResolver.cs" />
    <Compile Include="..\SqlTracker.Windows\Services\OracleProcessInfo.cs" Link="Services\OracleProcessInfo.cs" />
    <Compile Include="..\SqlTracker.Windows\Services\OracleProcessScanner.cs" Link="Services\OracleProcessScanner.cs" />
    <Compile Include="..\SqlTracker.Windows\Services\RemoteInjectionHandle.cs" Link="Services\RemoteInjectionHandle.cs" />
    <Compile Include="..\SqlTracker.Windows\Services\WindowsDllInjector.cs" Link="Services\WindowsDllInjector.cs" />
  </ItemGroup>
</Project>
